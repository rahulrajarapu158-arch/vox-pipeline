   "cell_type": "code",
   "metadata": {},
   "source": [
    "# @title 1. Clone LTX-Video repo + install (native inference path)\n",
    "# The 2B distilled model loads via the repo's own inference.py + yaml config,\n",
    "# NOT the diffusers from_pretrained call (that 404s on this repo).\n",
    "!git clone --depth 1 https://github.com/Lightricks/LTX-Video.git /content/ltx\n",
    "%cd /content/ltx\n",
    "!pip install -q -e .\n",
    "!pip install -q imageio imageio-ffmpeg"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# @title 2. Upload vault_door.jpeg\n",
    "# Drag vault_door.jpeg into the LEFT sidebar file browser, then run this.\n",
    "import os\n",
    "IMAGE_PATH = '/content/vault_door.jpeg'\n",
    "assert os.path.exists(IMAGE_PATH), 'Upload vault_door.jpeg to the left sidebar first'\n",
    "print('image present:', IMAGE_PATH)"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# @title 3. Run LTX 2B-Distilled image-to-video (portrait frame to match reference 720x1280)\n",
    "# Config: ltxv-2b-0.9.6-distilled.yaml -> checkpoint ltxv-2b-0.9.6-distilled-04-25.safetensors\n",
    "# Distilled: 8 steps, guidance 1, no STG. Free, fits Colab T4 (15GB).\n",
    "PROMPT = (\n",
    "    'Paper-collage animation style, flat illustrated vault door made of cut paper layers, '\n",
    "    'the paper pieces shift and lift slightly with a gentle hand-made stop-motion drift, '\n",
    "    'soft paper shadows, warm editorial color palette, Vox-style explainer motion, '\n",
    "    'subtle slow camera push-in, no 3D, no photorealism'\n",
    ")\n",
    "NEG = 'photorealistic, 3d render, CGI, jitter, flicker, distorted, blurry'\n",
    "\n",
    "!python inference.py \\\n",
    "  --prompt \"{PROMPT}\" \\\n",
    "  --negative_prompt \"{NEG}\" \\\n",
    "  --conditioning_media_paths {IMAGE_PATH} \\\n",
    "  --conditioning_start_frames 0 \\\n",
    "  --height 1280 --width 704 \\\n",
    "  --num_frames 121 \\\n",
    "  --seed 42 \\\n",
    "  --pipeline_config configs/ltxv-2b-0.9.6-distilled.yaml \\\n",
    "  --output_path /content/ltx_vault.mp4"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    # @title 4. Download result
    import os
    from google.colab import files
    if os.path.exists('/content/ltx_vault.mp4'):
    "    files.download('/content/ltx_vault.mp4')\n",
    "    print('Download triggered. Move to ~/Downloads/vox/ltx_vault.mp4 and ask Hermes to verify >=60%.')\n",
    "else:\n",
    "    print('ltx_vault.mp4 not found -- check the inference cell output above for errors.')"
   ],
   "outputs": []
  }
